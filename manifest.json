{
  "manifest_version": 3,
  "name": "Poppy Tool",
  "version": "5.0.2",
  "author": "Rcf",
  "description": "By Rcf - Poppy Tool for Cripsum: one widget on every page — auto-opens lootboxes (stop on rarity/character, queue, stats) plus dashboard, missions, inventory, achievements, inbox gifts and a 'collect everything' button.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Poppy Tool",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "notifications",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://cripsum.com/*",
    "https://www.cripsum.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://cripsum.com/*",
        "https://www.cripsum.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://cripsum.com/*",
        "https://www.cripsum.com/*"
      ],
      "js": [
        "site-modules.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "https://cripsum.com/*",
        "https://www.cripsum.com/*"
      ]
    }
  ]
}